<!-- Local rules -->
<!-- Modify it at your will. -->

<group name="local,syssec,">

  <!-- Regla personalizada: fuerza bruta SSH -->
  <!-- Dispara cuando hay 6+ fallos de autenticacion SSH -->
  <!-- en 60 segundos desde la misma IP de origen -->
  <rule id="100010" level="10" frequency="6" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>Posible fuerza bruta SSH: 6+ fallos en 60s desde la misma IP</description>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

</group>